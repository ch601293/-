{
  "app": {
    "bundleName": "com.huawei.amap.navigation.watch",
    "vendor": "Huawei",
    "version": {
      "code": 1000000,
      "name": "1.0.0"
    },
    "apiVersion": {
      "compatible": 9,
      "target": 10,
      "releaseType": "Release"
    }
  },
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "高德地图导航手表端显示应用",
    "mainElement": "NavigationWatchApp",
    "deviceTypes": [
      "wearable"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "src/ui/pages.json",
    "abilities": [
      {
        "name": "NavigationWatchApp",
        "srcEntry": "./src/main.cj",
        "description": "导航显示应用",
        "icon": "$media:icon",
        "label": "高德导航",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "visible": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "NotificationListenerService",
        "srcEntry": "./src/service/NotificationListener.cj",
        "description": "通知监听服务",
        "type": "service",
        "visible": true
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.NOTIFICATION_CONTROLLER",
        "reason": "需要监听高德地图导航通知",
        "usedScene": {
          "abilities": [
            "NavigationWatchApp"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.USE_BLUETOOTH",
        "reason": "需要使用蓝牙与手机通信",
        "usedScene": {
          "abilities": [
            "NavigationWatchApp"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.DISCOVER_BLUETOOTH",
        "reason": "需要发现蓝牙设备",
        "usedScene": {
          "abilities": [
            "NavigationWatchApp"
          ],
          "when": "always"
        }
      }
    ]
  }
}
